{
  "name": "@dprb-work/ui-lib",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.29.1",
  "engines": {
    "node": "24.22.3"
  },
  "files": [
    "dist",
    "src/theme.css",
    "src/palette.css"
  ],
  "sideEffects": [
    "./dist/*.css",
    "./src/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./chat": {
      "types": "./dist/chat.d.ts",
      "import": "./dist/chat.js"
    },
    "./chat/styles.css": "./dist/chat.css",
    "./charts": {
      "types": "./dist/charts.d.ts",
      "import": "./dist/charts.js"
    },
    "./data-table": {
      "types": "./dist/data-table.d.ts",
      "import": "./dist/data-table.js"
    },
    "./styles.css": "./dist/styles.css",
    "./theme.css": "./src/theme.css"
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "dev": "storybook dev --no-open --port 6006",
    "build": "pnpm run clean && tsc -p tsconfig.build.json && vite build",
    "build:storybook": "STORYBOOK_DISABLE_TELEMETRY=1 storybook build",
    "lint": "eslint .",
    "test": "vitest run --project=unit",
    "test:storybook": "vitest run --project=storybook",
    "prepare": "pnpm run build",
    "typecheck": "tsc -b",
    "check:base-deps": "python3 scripts/check_base_deps.py && node --test scripts/check-base-deps.node-test.mjs",
    "verify:fast": "pnpm run check:base-deps && eslint . && tsc -b && vitest run --project=unit && pnpm run build",
    "verify": "pnpm run verify:fast && STORYBOOK_DISABLE_TELEMETRY=1 vitest run --project=storybook && node --test tests/storybook-dev-server.test.mjs"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "lucide-react": "^1.31.0",
    "radix-ui": "^1.6.7",
    "tailwind-merge": "^3.6.0"
  },
  "peerDependencies": {
    "@icons-pack/react-simple-icons": "^13.15.1",
    "katex": "^0.18.7",
    "lowlight": "^3.3.0",
    "mdast-util-directive": "^3.1.0",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "remark-directive": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "strip-ansi": "^7.2.0",
    "unist-util-visit": "^5.1.0",
    "@tanstack/react-table": "9.1.2",
    "chart.js": "^4.5.1",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "peerDependenciesMeta": {
    "@icons-pack/react-simple-icons": { "optional": true },
    "katex": { "optional": true },
    "lowlight": { "optional": true },
    "mdast-util-directive": { "optional": true },
    "react-markdown": { "optional": true },
    "rehype-katex": { "optional": true },
    "remark-directive": { "optional": true },
    "remark-gfm": { "optional": true },
    "remark-math": { "optional": true },
    "strip-ansi": { "optional": true },
    "unist-util-visit": { "optional": true },
    "@tanstack/react-table": {
      "optional": true
    },
    "chart.js": {
      "optional": true
    }
  },
  "devDependencies": {
    "@icons-pack/react-simple-icons": "^13.15.1",
    "@types/hast": "^3.0.5",
    "@types/katex": "^0.16.8",
    "@types/mdast": "^4.0.4",
    "katex": "^0.18.7",
    "lowlight": "^3.3.0",
    "mdast-util-directive": "^3.1.0",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "remark-directive": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "strip-ansi": "^7.2.0",
    "unist-util-visit": "^5.1.0",
    "@tanstack/react-table": "9.1.2",
    "@eslint/js": "^10.0.1",
    "@storybook/addon-a11y": "10.6.2",
    "@storybook/addon-docs": "10.6.2",
    "@storybook/addon-themes": "10.6.2",
    "@storybook/addon-vitest": "10.6.2",
    "@storybook/react-vite": "10.6.2",
    "@tailwindcss/vite": "^4.1.11",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.10.2",
    "@types/react": "^19.1.9",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^4.7.0",
    "chart.js": "4.5.1",
    "@vitest/browser": "3.2.7",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.9.0",
    "jsdom": "^26.1.0",
    "playwright": "^1.62.1",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "storybook": "10.6.2",
    "tailwindcss": "^4.1.11",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.66.0",
    "vite": "^7.0.6",
    "vitest": "^3.2.7"
  }
}
