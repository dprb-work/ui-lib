{
  "name": "@dprb-work/ui-lib",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.29.1",
  "files": [
    "dist"
  ],
  "sideEffects": [
    "./dist/styles.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./charts": {
      "types": "./dist/charts.d.ts",
      "import": "./dist/charts.js"
    },
    "./data-table": {
      "types": "./dist/data-table.d.ts",
      "import": "./dist/data-table.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "dev": "storybook dev --no-open --port 6006",
    "build": "pnpm run clean && tsc -p tsconfig.build.json && vite build",
    "build:storybook": "STORYBOOK_DISABLE_TELEMETRY=1 storybook build",
    "lint": "eslint .",
    "test": "vitest run --project=unit",
    "test:storybook": "vitest run --project=storybook",
    "prepare": "pnpm run build",
    "typecheck": "tsc -b",
    "verify": "eslint . && tsc -b && vitest run --project=unit && STORYBOOK_DISABLE_TELEMETRY=1 vitest run --project=storybook && pnpm run build"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "lucide-react": "^1.31.0",
    "radix-ui": "^1.6.7",
    "tailwind-merge": "^3.6.0"
  },
  "peerDependencies": {
    "@tanstack/react-table": "9.1.2",
    "chart.js": "^4.5.1",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "peerDependenciesMeta": {
    "@tanstack/react-table": {
      "optional": true
    },
    "chart.js": {
      "optional": true
    }
  },
  "devDependencies": {
    "@tanstack/react-table": "9.1.2",
    "@eslint/js": "^10.0.1",
    "@storybook/addon-a11y": "10.5.7",
    "@storybook/addon-docs": "10.5.7",
    "@storybook/addon-themes": "10.5.7",
    "@storybook/addon-vitest": "10.5.7",
    "@storybook/react-vite": "10.5.7",
    "@tailwindcss/vite": "^4.1.11",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.10.2",
    "@types/react": "^19.1.9",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^4.7.0",
    "chart.js": "4.5.1",
    "@vitest/browser": "3.2.7",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.9.0",
    "jsdom": "^26.1.0",
    "playwright": "^1.62.1",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "storybook": "10.5.7",
    "tailwindcss": "^4.1.11",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.66.0",
    "vite": "^7.0.6",
    "vitest": "^3.2.7"
  }
}
